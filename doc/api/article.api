syntax = "v1"

info (
	title:  "noviterra博客文章相关接口"
	desc:   "noviterra博客文章管理模块article，负责文章的全部内容：CRUD、点赞、收藏、浏览、搜索等等"
	author: "noviterra"
)

// 8004
type (
	// api层统一响应体 请求状态承载体 需要特殊响应（需要包含数据）的将其嵌入到结构体中
	Response {
		Status  int    `json:"status"`
		Code    int    `json:"errcode"`
		Message string `json:"message"`
	}
	// 文章列表中单个实例属性
	ArticleList {
		ArticleID   string   `json:"article_id" validate:"required,min=1,max=100"`
		Title       string   `json:"title" validate:"required,min=1,max=100"`
		Cover       string   `json:"cover" validate:"required,min=1,max=20"`
		Tags        []string `json:"tags" validate:"required,min=1,max=5,dive,required,min=1,max=20"`
		Information string   `json:"information" validate:"required,min=1,max=200"`
		CreatedAt   string   `json:"created_at" validate:"required,timeformat=2006-01-02 15:04:05"`
	}
	// 文章详细属性
	Article {
		PublisherID string   `json:"publisher_id" validate:"required,min=1,max=100"`
		ArticleID   string   `json:"article_id" validate:"required,min=1,max=100"`
		Title       string   `json:"title" validate:"required,min=1,max=100"`
		Content     string   `json:"content" validate:"required,min=1"`
		Cover       string   `json:"cover" validate:"required,min=1,max=20"`
		Tags        []string `json:"tags" validate:"required,min=1,max=5,dive,required,min=1,max=20"`
		Information string   `json:"information" validate:"required,min=1,max=200"`
		Status      int      `json:"status"` // 0:草稿 1:已发布 2:私密 3:删除
		CreatedAt   string   `json:"created_at" validate:"required,timeformat=2006-01-02 15:04:05"`
		UpdatedAt   string   `json:"updated_at" validate:"required,timeformat=2006-01-02 15:04:05"`
	}
	// 归档文章体
	ArchiveArticle {
		Title      string `json:"title" validate:"required,min=1,max=100"`
		Action     string `json:"action" validate:"required,min=1,max=10,oneof=create update"` // 创建与更新
		ActionTime int64  `json:"action_time" validate:"required"`
	}
	// 增：发布文章
	PublishArticleRequest {
		Title   string `form:"title" json:"title" validate:"required,min=1,max=100"`
		Content string `form:"content" json:"content" validate:"required,min=1"`
		// Cover       string   `json:"cover" validate:"required,min=1,max=20"`
		Tags        []string `form:"tags" json:"tags" validate:"required,min=1,max=5,dive,required,min=1,max=20"`
		Information string   `form:"information" json:"information" validate:"required,min=1,max=200"` // 作为一篇文章的总结or简短介绍
	}
	// 删：删除文章
	DeleteArticleRequest {
		ArticleID string `json:"article_id" validate:"required,min=1,max=100"`
	}
	// 改：修改文章
	UpdateArticleRequest {
		ArticleID string `json:"article_id" validate:"required,min=1,max=100"`
		Title     string `json:"title" validate:"omitempty,min=1,max=100"`
		Content   string `json:"content" validate:"omitempty,min=1"`
		//Cover       string   `json:"cover" validate:"omitempty,url"`  // 封面单独抽出写一个接口
		Tags        []string `json:"tags" validate:"omitempty,min=1,max=5,dive,required,min=1,max=20"`
		Information string   `json:"information" validate:"omitempty,min=1,max=200"`
	}
	// 改：修改文章封面
	UpdateArticleCoverRequest {
		ArticleID string `json:"article_id" validate:"required,min=1,max=100"`
	}
	// 修改封面成功后 将封面重新渲染
	UpdateArticleCoverResponse {
		Cover string   `json:"cover" validate:"omitempty,min=1,max=20"`
		Resp  Response `json:"response"`
	}
	// 查：获取文章列表
	GetArticleListRequest {
		Page     int `json:"page" validate:"required,min=1"`
		PageSize int `json:"page_size" validate:"required,min=1,max=100"`
	}
	// 文章列表响应体
	GetArticleListResponse {
		ArticlesList []ArticleList `json:"articles_list"`
		Resp         Response      `json:"response"`
	}
	// 查：获取文章详情
	GetArticleDetailRequest {
		ArticleID string `path:"article" validate:"required,min=1,max=100"`
	}
	// 文章详情响应体
	GetArticleDetailResponse {
		Article Article  `json:"article"`
		Resp    Response `json:"response"`
	}
	// 查：搜索文章
	SearchArticleRequest {
		Query    string `json:"query" validate:"required,min=1,max=100"`
		Page     int    `json:"page" validate:"required,min=1"`
		PageSize int    `json:"page_size" validate:"required,min=1,max=100"`
	}
	// 搜索文章响应体
	SearchArticleResponse {
		ArticlesList []ArticleList `json:"articles_list"`
		Resp         Response      `json:"response"`
	}
	// 归档 得到归档格式的文章列表
	GetArchiveResponse {
		ArticleList []ArchiveArticle `json:"article_list" validate:"required"`
		Resp        Response         `json:"response"`
	}
	// 获得用户的点赞文章列表 查看个人或者他人
	GetUserLikesListRequest {
		UserID string `json:"user_id" validate:"required,min=1,max=100"`
	}
	GetUserLikesListResponse {
		ArticleList []ArticleList `json:"articles_list"`
		Resp        Response      `json:"response"`
	}
	// 获得用户的收藏点赞列表
	GetUserCollectListRequest {
		UserID string `json:"user_id" validate:"required,min=1,max=100"`
	}
	GetUserCollectListResponse {
		ArticleList []ArticleList `json:"articles_list"`
		Resp        Response      `json:"response"`
	}
	// 获得一个用户发布的文章列表
	GetUsersArticleListRequest {
		UserID string `json:"user_id" validate:"required,min=1,max=100"`
	}
	GetUsersArticleListResponse {
		ArticleList []ArticleList `json:"articles_list"`
		Resp        Response      `json:"response"`
	}
)

// 需要鉴权中间件的
@server (
	prefix: novblog/article
)
service articleService {
	@doc "发布文章"
	@handler PublishArticle
	post /publish (PublishArticleRequest) returns (Response)

	@doc "删除文章"
	@handler DeleteArticle
	post /delete (DeleteArticleRequest) returns (Response)

	@doc "修改文章"
	@handler UpdateArticle
	post /update/article (UpdateArticleRequest) returns (Response)

	@doc "修改文章封面"
	@handler UpdateArticleCover
	post /update/cover (UpdateArticleCoverRequest) returns (UpdateArticleCoverResponse)
}

// 不需要鉴权中间件的
@server (
	prefix: novblog/article
)
service articleService {
	@doc "获取文章列表"
	@handler GetArticleList
	get /list (GetArticleListRequest) returns (GetArticleListResponse)

	@doc "获取文章详情"
	@handler GetArticleDetail
	get /:article (GetArticleDetailRequest) returns (GetArticleDetailResponse)

	@doc "搜索文章"
	@handler SearchArticle
	post /search (SearchArticleRequest) returns (SearchArticleResponse)

	@doc "归档 时间轴展示博客与"
	@handler GetArchive
	get /archive returns (GetArchiveResponse)

	@doc "查看用户点赞文章列表"
	@handler GetUserLikesArticleList
	get /list/like (GetUserLikesListRequest) returns (GetUserLikesListResponse)

	@doc "查看用户收藏文章列表"
	@handler GetUserCollectArticleList
	get /list/collect (GetUserCollectListRequest) returns (GetUserCollectListResponse)

	@doc "查看用户发布文章列表"
	@handler GetUsersArticleList
	get /list/publish (GetUsersArticleListRequest) returns (GetUsersArticleListResponse)
}

// goctl api go -api ./doc/api/article.api -dir ./server/app/article/articleapi
