syntax = "v1"

info (
	title:  "Noviterra用户信息服务"
	desc:   "管理Noviterra的全部用户信息模块，包括但不限于获取用户信息、修改信息等等"
	author: "Noviterra"
)

// 8003
/*
goctl api go -api ./doc/api/user.api -dir ./server/app/user/userapi
*/

// 需要鉴权的
@server (
	prefix: novblog/user
)
service usersService {
	@doc "通过账号密码认证修改密码"
	@handler changePasswordByID
	post /changepassword/id (ChangePasswordByIDRequest) returns (Response)

	@doc "通过邮箱辅助认证修改个人密码"
	@handler changePasswordByEmail
	post /changepassword/email (ChangePasswordByEmailRequest) returns (Response)

	@doc "得到个人信息"
	@handler getUserInfo
	get /info returns (UserInfoResponse)

	@doc "批量获取用户信息"
	@handler batchGetUserInfo
	get /batchinfo (BatchUserInfoRequest) returns (BatchUserInfoResponse)

	@doc "封禁用户"
	@handler blacklistUser
	post /blackusers (BlacklistUserRequest) returns (Response)

	@doc "解封用户"
	@handler unblacklistUser
	post /unblackusers (UnblacklistUserRequest) returns (Response)

	@handler updateUserInfo
	post /updateinfo (UpdateUserInfoRequest) returns (Response)
}

type (
	// 对于响应 除特殊情况外进行统一封装
	Response {
		Status  int    `json:"status"`
		Code    int    `json:"errcode"`
		Message string `json:"message"`
	}
	// 用户信息体
	UserInfo {
		ID               string `json:"id"`
		Role             int    `json:"Role"` // 0:普通用户 1:超级管理员
		Username         string `json:"username"`
		Email            string `json:"email"`
		Avatar           string `json:"avatar"`
		Age              int    `json:"age"`
		Gender           int    `json:"gender"` // 0:未知 1:男 2:女
		SelfIntroduction string `json:"self_introduction"`
	}
	// 修改密码 ?type=ID
	ChangePasswordByIDRequest {
		//ID          string `json:"id" validate:"required,min=6,max=10"`  // 通过鉴权中间件获取
		OldPassword string `json:"old_password" validate:"required,min=6,max=20"`
		NewPassword string `json:"new_password" validate:"required,min=6,max=20"`
	}
	// 修改密码 ?type=Email
	ChangePasswordByEmailRequest {
		Email            string `json:"email" validate:"required,email"`
		VerificationCode string `json:"verification_code" validate:"required,len=6"`
		NewPassword      string `json:"new_password" validate:"required,min=6,max=20"`
	}
	// 拉黑用户
	BlacklistUserRequest {
		ID string `json:"id" validate:"required,min=6,max=10"`
	}
	// 解封用户
	UnblacklistUserRequest {
		ID string `json:"id" validate:"required,min=6,max=10"`
	}
	// 获取用户信息
	UserInfoResponse {
		Info UserInfo `json:"info"`
		Resp Response `json:"response"`
	}
	// 管理员批量获取用户信息  分页查询
	BatchUserInfoRequest {
		size int `json:"size" validate:"required,min=5,max=15"`
		page int `json:"page" validate:"required,min=1"`
	}
	BatchUserInfoResponse {
		Users []UserInfo `json:"users"`
		Resp  Response   `json:"response"`
	}
	// 用户更新信息
	UpdateUserInfoRequest {
		//ID               string `json:"id" validate:"required,min=6,max=10"`  // 由鉴权中间件获取
		Username string `json:"username" validate:"omitempty,min=2,max=20"`
		//Email            string `json:"email" validate:"omitempty,email"`  // 涉及换绑功能 另起功能
		Avatar           string `json:"avatar" validate:"omitempty,url"`
		Age              int    `json:"age" validate:"omitempty,gte=0,lte=150"`
		Gender           int    `json:"gender" validate:"omitempty"`
		SelfIntroduction string `json:"self_introduction" validate:"omitempty,max=200"`
	}
)

goctl api go -api ./doc/api/user.api -dir ./server/app/user/userapi
